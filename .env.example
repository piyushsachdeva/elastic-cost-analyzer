# .env.example — copy to .env.local and fill in real values
# .env.local is gitignored — never commit credentials

# AWS Secrets Manager ARNs (set during infrasetup.md §5)
ELASTIC_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:cost-anomaly-agent/elastic-creds-XXXXXX
SLACK_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:cost-anomaly-agent/slack-webhook-XXXXXX

# Bedrock region
AWS_BEDROCK_REGION=us-east-1

# Agent tuning
SPIKE_THRESHOLD_PCT=25.0
AGENT_MAX_ITERATIONS=20

# AWS credentials — use SSO token or access key depending on your setup.
# If running inside Lambda, IAM role provides these automatically.
# For local Docker testing (make run-local), fill these in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Bedrock model ID — MUST use cross-region inference profile (us. prefix).
# Direct foundation model IDs (no prefix) are not supported for on-demand throughput.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
